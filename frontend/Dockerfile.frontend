# Build context: raíz del repositorio (monorepo frontend + backend)
# Versión: si no pasas NEXT_PUBLIC_APP_VERSION (o es "dev"), se usa la fecha/hora del build (YYYY.MM.DD.HHMMSS).

FROM alpine:3.18 AS version
RUN date +%Y.%m.%d.%H%M%S > /version.txt

FROM node:20-alpine AS base

# Dependencias (pnpm; para usar npm cambia a COPY package-lock.json y npm ci)
FROM base AS deps
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY frontend/package.json frontend/pnpm-lock.yaml ./
COPY frontend/.npmrc ./
RUN pnpm install --frozen-lockfile

# Build
FROM base AS builder
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@latest --activate
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
COPY --from=version /version.txt ./version.txt

# Variables de build (NEXT_PUBLIC_* se embeben en el build)
ARG NEXT_PUBLIC_BACKEND_URL
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_APP_URL
ARG NEXT_PUBLIC_STACK_PROJECT_ID
ARG NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY
ARG NEXT_PUBLIC_APP_VERSION=dev
ENV NEXT_PUBLIC_BACKEND_URL=$NEXT_PUBLIC_BACKEND_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL
ENV NEXT_PUBLIC_STACK_PROJECT_ID=$NEXT_PUBLIC_STACK_PROJECT_ID
ENV NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=$NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY
# Standalone necesario para la imagen final; en Windows local da EPERM (symlinks)
ENV NEXT_STANDALONE=1
# Versión automática: si es "dev", usar timestamp del build; si no, usar el ARG
RUN if [ "$NEXT_PUBLIC_APP_VERSION" = "dev" ] || [ -z "$NEXT_PUBLIC_APP_VERSION" ]; then export NEXT_PUBLIC_APP_VERSION=$(cat version.txt); fi && pnpm run build

# Comprobar que existe el output standalone
RUN ls -la /app/.next/standalone/ || (echo "ERROR: .next/standalone no existe" && exit 1)
RUN test -f /app/.next/standalone/server.js || (echo "ERROR: server.js no existe" && exit 1)

# Imagen final
FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

CMD ["node", "server.js"]
