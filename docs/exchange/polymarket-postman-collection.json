								"trading",
								"orders",
								"{{order_id}}"
							]
						},
						"description": "Cancela una orden específica. Usa un order_id de la respuesta de 3.2 o 4.1/4.2"
					},
					"response": []
				},
				{
					"name": "4.5 Cancelar Todas las Órdenes",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/polymarket/trading/orders",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"polymarket",
								"trading",
								"orders"
							]
						},
						"description": "Cancela todas las órdenes abiertas.\n\n**IMPORTANTE**: Esto cancelará TODAS las órdenes abiertas. Usa con precaución."
					},
					"response": []
				}
			],
			"description": "Tests para operaciones de trading. **ADVERTENCIA**: Estas operaciones crean/cancelan órdenes reales en Polymarket."
