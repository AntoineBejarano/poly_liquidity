								"connection",
								"status"
							]
						},
						"description": "Verifica el estado de la conexión con Polymarket:\n- Variables de entorno configuradas\n- Estado del cliente CLOB\n- Disponibilidad de APIs"
					},
					"response": []
				},
				{
					"name": "1.2 Test Autenticación",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/polymarket/connection/test-auth",
