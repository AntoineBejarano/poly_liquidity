{
	"info": {
		"_postman_id": "polymarket-integration-tests",
		"name": "Polymarket Integration Tests",
		"description": "Colección completa de tests para todas las fases de integración con Polymarket",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Fase 0: Modo y Protecciones",
			"item": [
				{
					"name": "0.1 Verificar Execution Mode",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/system/config/execution-mode",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"system",
								"config",
								"execution-mode"
							]
						},
						"description": "Verifica el modo de ejecución actual (DRY_RUN, PAPER, LIVE).\n\n**Gates**: Si es LIVE, requiere confirmación explícita."
					},
					"response": []
				},
				{
					"name": "0.2 Verificar Parámetros Protegidos",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/system/config/protected-parameters",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"system",
								"config",
								"protected-parameters"
							]
						},
						"description": "Lista parámetros protegidos y sus valores.\n\n**Gates**: Verificar que allow_zero_checker, quorum_base, etc. tienen valores seguros."
					},
					"response": []
				},
				{
					"name": "0.3 Verificar Checkers",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/checkers/health",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"checkers",
								"health"
							]
						},
						"description": "Estado de salud de checkers y quorum efectivo.\n\n**Gates**: Si 0 checkers saludables y allow_zero_checker=false → sistema degradado."
					},
					"response": []
				},
				{
					"name": "0.4 Verificar Risk Engine",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/risk/status",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"risk",
								"status"
							]
						},
						"description": "Estado del Risk Engine y circuit breakers.\n\n**Gates**: Verificar que Risk Engine está activo y circuit breakers configurados."
					},
					"response": []
				}
			],
			"description": "Tests para verificar modo y protecciones ANTES de tocar APIs de Polymarket"
		},
