					"name": "3.3 Listar Órdenes con Filtros",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/polymarket/account/orders?market={{condition_id}}&asset_id={{token_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
