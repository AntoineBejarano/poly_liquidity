		{
			"name": "Fase 4: Trading",
			"item": [
				{
					"name": "4.1 Crear Limit Order BUY",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token_id\": \"{{token_id}}\",\n  \"price\": 0.50,\n  \"size\": 100,\n  \"side\": \"BUY\",\n  \"order_type\": \"GTC\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/polymarket/trading/orders/limit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"polymarket",
								"trading",
								"orders",
								"limit"
							]
						},
						"description": "Crea una limit order BUY. Requiere autenticación.\n\n**IMPORTANTE**: Esto creará una orden real en Polymarket. Usa con precaución."
					},
					"response": []
				},
				{
					"name": "4.2 Crear Limit Order SELL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token_id\": \"{{token_id}}\",\n  \"price\": 0.60,\n  \"size\": 100,\n  \"side\": \"SELL\",\n  \"order_type\": \"GTC\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/polymarket/trading/orders/limit",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"polymarket",
								"trading",
								"orders",
								"limit"
							]
						},
						"description": "Crea una limit order SELL. Requiere autenticación.\n\n**IMPORTANTE**: Esto creará una orden real en Polymarket. Usa con precaución."
					},
					"response": []
				},
				{
					"name": "4.3 Crear Market Order",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"token_id\": \"{{token_id}}\",\n  \"amount\": 10,\n  \"side\": \"BUY\",\n  \"order_type\": \"FOK\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/polymarket/trading/orders/market",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"polymarket",
								"trading",
