############################################
# Stack Auth - Server Key (validación tokens)
############################################
STACK_SECRET_SERVER_KEY=


############################################
# Base de datos
############################################
DATABASE_URL=sqlite:///./poly_liquidity.db

# Neon Data API (opcional)
DATA_API_ENDPOINT=


############################################
# Polymarket - Credenciales (política v2: NO hay wallet global)
# CLOB siempre se obtiene por usuario: get_polymarket_client_for_user(user_id) con wallet en BD.
############################################
# Legacy: no se usan para trading. Dejar vacíos. Las wallets están en BD por usuario.
PRIVATE_KEY=
FUNDER_ADDRESS=
# Alternativa: POLYMARKET_PROXY_ADDRESS (solo referencia; trading usa wallet en BD)

# API L2 por usuario (se derivan de la wallet activa en BD)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=


############################################
# Red (Polygon)
############################################
CHAIN_ID=137
RPC_URL=


############################################
# Builders (OPCIONAL)
############################################
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=


############################################
# Polymarket - URLs de API
############################################
POLYMARKET_API_URL=https://api.polymarket.com
POLYMARKET_DATA_API_URL=https://data-api.polymarket.com
POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
# Timeouts para GET /markets a Gamma (segundos). Si ves "gamma timeout", sube estos valores (ej. 3, 10, 15).
# GAMMA_CONNECT_TIMEOUT=1
# GAMMA_READ_TIMEOUT=4
# GAMMA_OVERALL_TIMEOUT=5
POLYMARKET_TRADING_API_URL=https://clob.polymarket.com


############################################
# Server
############################################
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000
# APP_VERSION= (inyectado en build Docker)


############################################
# Logging
############################################
LOG_LEVEL=INFO
LOG_FORMAT=json


############################################
# Redis
# Una sola conexión: cache L2, singleflight lock, circuit breaker (Plan Redis).
############################################
# TCP (preferido): redis://default:password@host:port  o  rediss://... para TLS
REDIS_URL=

# Legacy Upstash REST (si no usas TCP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Opcional: true si TLS; si no, se infiere de rediss:// en REDIS_URL
# REDIS_TLS=true

REDIS_TIMEOUT_MS=100
REDIS_KEY_PREFIX=poly:

# Cache L2: memory = solo en memoria; redis = L2 Redis (fallback a memory si Redis no disponible)
CACHE_PROVIDER=memory
# TTL del lock singleflight (8–10 s)
REDIS_LOCK_TTL_SECONDS=10
# Solo depuración: incluir X-Cache-Key en GET /markets (no usar en prod)
DEBUG_CACHE_HEADERS=false


############################################
# Wallet
# OBLIGATORIO en producción: clave Fernet base64 para cifrar claves en DB.
# Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
############################################
WALLET_ENCRYPTION_KEY=


############################################
# Feature flags
############################################
USE_GRAPH_STRATEGIES=false
# Solo staging/internal; NO en prod
SCENARIO_RUNNER_ENABLED=false


############################################
# Latency Monitor (opcional)
############################################
LATENCY_CACHE_TTL_SECONDS=30
LATENCY_STALE_TTL_SECONDS=60
LATENCY_LOCK_TTL_SECONDS=10
LATENCY_MIN_INTERVAL_SECONDS=10
LATENCY_BACKOFF_MAX_SECONDS=60
LATENCY_COLLECTOR_INTERVAL_SECONDS=60

# Umbrales (ms)
LATENCY_BACKEND_GREEN_THRESHOLD=100
LATENCY_BACKEND_YELLOW_THRESHOLD=200
LATENCY_POLYMARKET_DATA_GREEN_THRESHOLD=150
LATENCY_POLYMARKET_DATA_YELLOW_THRESHOLD=300
LATENCY_POLYMARKET_TRADING_GREEN_THRESHOLD=150
LATENCY_POLYMARKET_TRADING_YELLOW_THRESHOLD=300
LATENCY_EXECUTION_GREEN_THRESHOLD=250
LATENCY_EXECUTION_YELLOW_THRESHOLD=500
