# Build context: raíz del repositorio (monorepo frontend + backend)
# Versión: si no pasas --build-arg APP_VERSION, se usa la fecha/hora del build (YYYY.MM.DD.HHMMSS).
# Ejemplo con versión fija: docker build -f backend/Dockerfile.backend --build-arg APP_VERSION=v1.2.3 .

FROM alpine:3.18 AS version
RUN date +%Y.%m.%d.%H%M%S > /version.txt

FROM python:3.11-slim

WORKDIR /app

ARG APP_VERSION=dev
COPY --from=version /version.txt /tmp/build_version.txt
RUN if [ "$APP_VERSION" = "dev" ] || [ -z "$APP_VERSION" ]; then cp /tmp/build_version.txt /app/version.txt; else echo "$APP_VERSION" > /app/version.txt; fi

# Dependencias del sistema
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Dependencias Python
COPY backend/requirements.txt backend/
RUN pip install --no-cache-dir -r backend/requirements.txt

# Código de la aplicación (desde la raíz del repo)
COPY backend/ /app/backend/
COPY scripts/ /app/scripts/

RUN chmod +x /app/scripts/start.sh

EXPOSE 8000

CMD ["/app/scripts/start.sh"]
